# Thư mục chứa thư viện Node.js
node_modules/
backend/node_modules/
jspm_packages/
web_modules/

# File log lỗi
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Các file biến môi trường chứa secret/key
.env
